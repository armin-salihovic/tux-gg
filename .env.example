# Local development: one PostgreSQL login for setup, migrations, tools, and the app.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vapourdb
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

BETTER_AUTH_SECRET=YOUR_EXISTING_AUTH_SECRET
BETTER_AUTH_URL=http://127.0.0.1:5174
PUBLIC_SITE_URL=http://127.0.0.1:5174
ORIGIN=http://127.0.0.1:5174
STEAM_API_KEY=
PUBLIC_CONTACT_EMAIL=
NODE_ENV=development
