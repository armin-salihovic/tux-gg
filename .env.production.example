# Copy to a private environment file outside the repository before deployment.
DATABASE_URL=postgresql://tuxgg_app:replace-with-generated-password@host.docker.internal:5432/tuxgg
DATABASE_URL_DOCKER=postgresql://tuxgg_app:replace-with-generated-password@host.docker.internal:5432/tuxgg
# Used only by host-side migration commands; Compose does not pass either admin URL to the app.
MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-admin-password@localhost:5432/tuxgg
PGADMIN_URL=postgresql://postgres:replace-with-admin-password@localhost:5432/postgres
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes
BETTER_AUTH_URL=https://tuxgg.example.invalid
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_SITE_URL=https://tuxgg.example.invalid
PUBLIC_CONTACT_EMAIL=
NODE_ENV=production
PORT=3000
