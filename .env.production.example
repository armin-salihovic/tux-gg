# Copy to a private environment file outside the repository before deployment.
DATABASE_URL=postgresql://vapourdb_web:replace-with-generated-password@host.docker.internal:5432/vapourdb
# Host-side importer credential. Do not pass this variable to the web container.
IMPORTER_DATABASE_URL=postgresql://vapourdb_importer:replace-with-generated-password@localhost:5432/vapourdb
# Used only by host-side migration commands; Compose does not pass it to the app.
MIGRATION_DATABASE_URL=postgresql://vapourdb_migrator:replace-with-generated-password@localhost:5432/vapourdb
# Optional operator-only maintenance URL; provide transiently when provisioning is required.
PGADMIN_URL=postgresql://postgres:replace-with-admin-password@localhost:5432/postgres
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes
BETTER_AUTH_URL=https://vapourdb.example.invalid
ORIGIN=https://vapourdb.example.invalid
STEAM_API_KEY=
PUBLIC_SITE_URL=https://vapourdb.example.invalid
PUBLIC_CONTACT_EMAIL=
NODE_ENV=production
PORT=3000
