# Copy to a private environment file outside the repository before deployment.
DATABASE_URL=postgresql://tuxgg_web:replace-with-generated-password@host.docker.internal:5432/tuxgg
DATABASE_URL_DOCKER=postgresql://tuxgg_web:replace-with-generated-password@host.docker.internal:5432/tuxgg
# Host-side importer credential. Do not pass this variable to the web container.
IMPORTER_DATABASE_URL=postgresql://tuxgg_importer:replace-with-generated-password@localhost:5432/tuxgg
# Used only by host-side migration commands; Compose does not pass either admin URL to the app.
MIGRATION_DATABASE_URL=postgresql://tuxgg_migrator:replace-with-generated-password@localhost:5432/tuxgg
PGADMIN_URL=postgresql://postgres:replace-with-admin-password@localhost:5432/postgres
BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes
BETTER_AUTH_URL=https://tuxgg.example.invalid
ORIGIN=https://tuxgg.example.invalid
STEAM_API_KEY=
PUBLIC_SITE_URL=https://tuxgg.example.invalid
PUBLIC_CONTACT_EMAIL=
NODE_ENV=production
PORT=3000
