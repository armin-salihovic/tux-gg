# Copy to a private environment file outside Git. The same account performs
# runtime queries, migrations, catalog restores, backups, and diagnostics.
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=vapourdb
DB_USERNAME=YOUR_POSTGRES_USERNAME
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-bytes
BETTER_AUTH_URL=https://vapourdb.example.invalid
ORIGIN=https://vapourdb.example.invalid
STEAM_API_KEY=
PUBLIC_SITE_URL=https://vapourdb.example.invalid
PUBLIC_CONTACT_EMAIL=
NODE_ENV=production
PORT=3000
