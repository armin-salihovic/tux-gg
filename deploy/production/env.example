# Copy to /opt/vapourdb-config/vapourdb.env on the VPS and replace placeholders.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
ORIGIN=https://vapourdb.com
BETTER_AUTH_URL=https://vapourdb.com
PUBLIC_SITE_URL=https://vapourdb.com

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vapourdb
DB_USERNAME=vapourdb
DB_PASSWORD=replace-with-existing-vapourdb-role-password

BETTER_AUTH_SECRET=replace-with-a-new-production-secret
STEAM_API_KEY=
PUBLIC_CONTACT_EMAIL=
